POSTGRES_PASSWORD=<GENERATE_LOCAL_PASSWORD>
DATABASE_URL=postgresql+psycopg://product_agent:<URL_ENCODED_PASSWORD>@127.0.0.1:54329/product_agent
JWT_SECRET=<GENERATE_AT_LEAST_32_BYTE_RANDOM_SECRET>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEMO_ADMIN_PASSWORD=<SET_LOCAL_DEMO_PASSWORD>
DEMO_PM_PASSWORD=<SET_LOCAL_DEMO_PASSWORD>
DEMO_SALES_PASSWORD=<SET_LOCAL_DEMO_PASSWORD>
EMBEDDING_PROVIDER=local_sentence_transformers
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_REVISION=main
EMBEDDING_DIMENSIONS=512
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_TIMEOUT_SECONDS=30
RAG_TOP_K_DEFAULT=5
RAG_TOP_K_MAX=8
RAG_MIN_SIMILARITY=0.30
RAG_CONTEXT_MAX_CHARS=8000
PARSING_STALE_MINUTES=10
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_ROUTER_MODEL=deepseek-v4-flash
LLM_GENERATION_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1500
